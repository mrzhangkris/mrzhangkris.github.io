{"title": "sub_filter_types 实测", "lines": [
  {"t": "cmd", "s": "curl localhost/data.json   # 默认只处理 text/html"},
  {"t": "out", "s": "{\"url\": \"http://old.example.com\"}   # 原样"},
  {"t": "config", "s": "sub_filter_types application/json;"},
  {"t": "cmd", "s": "curl localhost/data.json"},
  {"t": "out", "s": "{\"url\": \"http://new.example.com\"}  # 生效"},
  {"t": "note", "s": "要替换 JSON/CSS/JS 必须显式加类型"}
]}
