{"title": "index 指令按顺序命中实测", "lines": [
  {"t": "note", "s": "实测环境：nginx/1.31.5 容器，root /usr/share/nginx/html"},
  {"t": "config", "s": "index index.html index.htm;"},
  {"t": "cmd", "s": "printf A > /usr/share/nginx/html/index.html"},
  {"t": "cmd", "s": "printf B > /usr/share/nginx/html/index.htm"},
  {"t": "cmd", "s": "curl -s localhost/"},
  {"t": "out", "s": "A"},
  {"t": "cmd", "s": "rm /usr/share/nginx/html/index.html"},
  {"t": "cmd", "s": "curl -s localhost/"},
  {"t": "out", "s": "B"},
  {"t": "note", "s": "排前的 index.html 优先命中；删掉后轮到 index.htm"}
]}
