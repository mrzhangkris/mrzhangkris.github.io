{"title": "正向与反向解析实测", "lines": [
  {"t": "cmd", "s": "dig @127.0.0.1 www.example.com A +short"},
  {"t": "out", "s": "192.168.254.150"},
  {"t": "cmd", "s": "dig @127.0.0.1 -x 192.168.254.150 +short"},
  {"t": "out", "s": "ns1.example.com."},
  {"t": "out", "s": "www.example.com."},
  {"t": "cmd", "s": "nslookup www.example.com 127.0.0.1"},
  {"t": "out", "s": "Name:   www.example.com"},
  {"t": "out", "s": "Address: 192.168.254.150"},
  {"t": "note", "s": "正反解析都命中；实测环境：Rocky Linux 9 容器"}
]}
