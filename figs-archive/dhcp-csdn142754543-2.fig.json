  {"t": "out", "s": "Internet Systems Consortium DHCP Server 4.2.5"},
  {"t": "out", "s": "WARNING: Host declarations are global."},
  {"t": "out", "s": "  They are not limited to the scope you"},
  {"t": "out", "s": "  declared them in."},
  {"t": "cmd", "s": "echo $?"},
  {"t": "out", "s": "0"},
  {"t": "note", "s": "退出码 0 = 语法正确；告警另有所指，见正文"}
]}
