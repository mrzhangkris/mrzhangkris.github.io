{"title": "非白名单来源：any 与 all 的分水岭", "lines": [
  {"t": "cmd", "s": "curl -si http://172.31.6.20/ | head -1"},
  {"t": "out", "s": "HTTP/1.1 401 Unauthorized"},
  {"t": "cmd", "s": "curl -si -u user:password1 http://172.31.6.20/ | head -1"},
  {"t": "out", "s": "HTTP/1.1 200 OK"},
  {"t": "note", "s": "satisfy any：来源 172.31.6.10 走密码门，输对即放行"},
  {"t": "cmd", "s": "curl -si -u user:password1 http://172.31.6.20:8002/ | head -1"},
  {"t": "out", "s": "HTTP/1.1 403 Forbidden"},
  {"t": "note", "s": "satisfy all：IP 不在名单，密码对也是 403"},
  {"t": "note", "s": "实测环境：nginx:alpine 容器 (nginx/1.31.5)，跨容器来源"}
]}
