{
  "title": "超限与错误混入的失败形态（实拍）",
  "lines": [
    {"t": "cmd", "s": "curl -sw %{http_code} localhost/css/??style1.css,ghost.css"},
    {"t": "out", "s": "404"},
    {"t": "cmd", "s": "curl -sw %{http_code} \"localhost/css/??style1.css,style2.css,style3.css\""},
    {"t": "out", "s": "400  (concat_max_files 2)"},
    {"t": "out", "s": "error.log: client sent too many concat filenames"},
    {"t": "note", "s": "类型不在 concat_types：400 且不写 error.log"}
  ]
}
