{
  "title": "错误写法：密码文件对 worker 不可读",
  "lines": [
    {"t": "config", "s": "chmod 640 /etc/nginx/.htpasswd  # root:root 640"},
    {"t": "cmd", "s": "curl -so /dev/null -w \"%{http_code}\\n\" -u $u $url"},
    {"t": "out", "s": "500"},
    {"t": "note", "s": "crit: open() \"/etc/nginx/.htpasswd\" failed (13: Permission denied)"},
    {"t": "cmd", "s": "chmod 644 /etc/nginx/.htpasswd"},
    {"t": "cmd", "s": "curl -so /dev/null -w \"%{http_code}\\n\" -u $u $url"},
    {"t": "out", "s": "200"},
    {"t": "note", "s": "实测环境：nginx/1.31.5（nginx:alpine 容器）"}
  ]
