{
  "title": "nginx timeouts",
  "type": "config",
  "lines": [
    {"t": "config", "s": "location / {"},
    {"t": "config", "s": "  proxy_pass http://backend_server;"},
    {"t": "config", "s": "  proxy_connect_timeout 30s;"},
    {"t": "config", "s": "  proxy_read_timeout 300s;"},
    {"t": "config", "s": "  proxy_send_timeout 30s;"},
    {"t": "config", "s": "  keepalive_timeout 300s;"},
    {"t": "config", "s": "}"}
  ]
}
