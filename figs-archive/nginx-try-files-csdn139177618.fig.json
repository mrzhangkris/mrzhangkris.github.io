{
  "title": "nginx 1.31.5 try_files 实测",
  "type": "cmd",
  "lines": [
    {"t": "config", "s": "try_files $uri $uri/ /index.html;"},
    {"t": "cmd", "s": "curl -s localhost/nope.html"},
    {"t": "out", "s": "<h1>INDEX</h1>  # 200,SPA 回退"},
    {"t": "cmd", "s": "curl -s -o /dev/null -w %{http_code} localhost/report/"},
    {"t": "out", "s": "403  # $uri/ 命中目录,无 index"},
    {"t": "cmd", "s": "curl -s 'localhost/missing?id=42'"},
    {"t": "out", "s": "qs=id=42  # ?$query_string 带参数"},
    {"t": "note", "s": "兜底目标指向自己 → 500 死循环"}
  ]
}
