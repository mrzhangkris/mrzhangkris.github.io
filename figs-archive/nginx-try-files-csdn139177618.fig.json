{
  "title": "try_files 一条指令：依次找 + 兜底",
  "type": "cmd",
  "lines": [
    {"t": "config", "s": "try_files $uri $uri/ /index.html;"},
    {"t": "cmd", "s": "curl -s -w ' [%{http_code}]' localhost:8080/orders/42"},
    {"t": "out", "s": "<h1>INDEX</h1> [200]"},
    {"t": "note", "s": "# 前两个参数落空,兜底 /index.html,SPA 回退"},
    {"t": "cmd", "s": "curl -s -w ' [%{http_code}]' localhost:8080/report/"},
    {"t": "out", "s": "[403]"},
    {"t": "note", "s": "# $uri/ 命中目录但目录里没有 index 文件"},
    {"t": "note", "s": "实测环境：nginx/1.31.5 (nginx:alpine 容器,宿主 8080→80)"}
  ]
}
