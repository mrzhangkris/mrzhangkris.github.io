{"title": "安装版本与本地登录（Rocky 9）", "lines": [
  {"t": "cmd", "s": "dnf install -y mariadb mariadb-server"},
  {"t": "cmd", "s": "rpm -q mariadb-server"},
  {"t": "out", "s": "mariadb-server-10.5.29-3.el9_7.aarch64"},
  {"t": "cmd", "s": "mysql -uroot -e \"select version();\""},
  {"t": "out", "s": "version()"},
  {"t": "out", "s": "10.5.29-MariaDB"},
  {"t": "note", "s": "RHEL9 源即 10.5；CentOS 7.6 同法装到 5.5.x（EOL 需切 vault）"},
  {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器 (dnf)"}
]}
