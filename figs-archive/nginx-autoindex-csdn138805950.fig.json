{
  "title": "nginx autoindex",
  "type": "config",
  "lines": [
    {"t": "config", "s": "location /content/ {"},
    {"t": "config", "s": "  root /var/www/html;"},
    {"t": "config", "s": "  autoindex on;"},
    {"t": "config", "s": "  autoindex_exact_size off;"},
    {"t": "config", "s": "  autoindex_localtime on;"},
    {"t": "config", "s": "}"}
  ]
}
