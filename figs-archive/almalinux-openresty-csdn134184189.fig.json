{
  "title": "编译安装：configure → gmake → gmake install",
  "lines": [
    {"t": "cmd", "s": "./configure --prefix=/apps/openresty"},
    {"t": "out", "s": "Type the following commands to build and install:"},
    {"t": "out", "s": "    gmake"},
    {"t": "out", "s": "    gmake install"},
    {"t": "cmd", "s": "gmake && gmake install"},
    {"t": "out", "s": "gmake[1]: Leaving directory '.../build/nginx-1.31.1'"},
    {"t": "out", "s": "ln -sf /apps/openresty/nginx/sbin/nginx /apps/openresty/bin/openresty"},
    {"t": "cmd", "s": "ls /apps/openresty"},
    {"t": "out", "s": "COPYRIGHT bin luajit lualib nginx pod resty.index site"},
    {"t": "note", "s": "实测环境：AlmaLinux 9.8 容器，OpenResty 1.31.1.1"}
  ]
}
