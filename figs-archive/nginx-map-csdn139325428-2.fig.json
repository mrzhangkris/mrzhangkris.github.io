{"title": "map 正则映射：按 UA 判设备", "lines": [
  {"t": "config", "s": "map $http_user_agent $is_mobile {"},
  {"t": "config", "s": "  ~*(android|iphone|mobile) 1;  default 0;"},
  {"t": "config", "s": "}"},
  {"t": "cmd", "s": "curl -s -A iphone localhost/"},
  {"t": "out", "s": "is_mobile=1"},
  {"t": "cmd", "s": "curl -s -A linux localhost/"},
  {"t": "out", "s": "is_mobile=0"},
  {"t": "note", "s": "判断收敛进 map，location 里只剩使用变量"},
  {"t": "note", "s": "实测环境：nginx/1.31.5（docker nginx:alpine 容器）"}
]}
