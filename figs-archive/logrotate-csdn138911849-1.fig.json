{"title": "干跑 + 强制轮转 + 请求验证", "lines": [
  {"t": "cmd", "s": "logrotate -d /etc/logrotate.d/nginx"},
  {"t": "out", "s": "rotating pattern: /var/log/nginx/*.log weekly ..."},
  {"t": "cmd", "s": "logrotate -f -s /tmp/lr.state /etc/logrotate.d/nginx"},
  {"t": "out", "s": "-rw-r--r-- 1 nginx nginx    0 access.log"},
  {"t": "out", "s": "-rw-r--r-- 1 root  root    66 access.log.1.gz"},
  {"t": "cmd", "s": "curl -s localhost >/dev/null && wc -c /var/log/nginx/access.log"},
  {"t": "out", "s": "84 /var/log/nginx/access.log"},
  {"t": "note", "s": "新文件 0 字节属主 nginx；旧日志压缩成 .gz；新请求落新文件"},
  {"t": "note", "s": "实测环境：nginx:alpine (nginx/1.31.5, logrotate 3.22.0)"}
]}
