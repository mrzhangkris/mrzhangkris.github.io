{
  "title": "dig 正反解析实测",
  "lines": [
    {"t": "note", "s": "named 启动后正反解析实测"},
    {"t": "cmd", "s": "dig @localhost www.example.com +short"},
    {"t": "out", "s": "192.168.1.2"},
    {"t": "cmd", "s": "dig @localhost -x 192.168.1.2 +short"},
    {"t": "out", "s": "www.example.com."},
    {"t": "note", "s": "A 记录与 PTR 记录互相对应"}
  ]
}
