{
  "title": "profile 恒回源；no_cache=1 参数同样绕过（实测）",
  "lines": [
    {"t": "cmd", "s": "curl -si localhost/profile/ | grep -E '^HTTP|X-Proxy-Cache'"},
    {"t": "out", "s": "HTTP/1.1 200 OK"},
    {"t": "out", "s": "X-Proxy-Cache: BYPASS"},
    {"t": "note", "s": "proxy_cache_bypass 1 恒真，永远回源"},
    {"t": "cmd", "s": "curl -si 'localhost/?no_cache=1' | grep X-Proxy-Cache"},
    {"t": "out", "s": "X-Proxy-Cache: BYPASS"},
    {"t": "note", "s": "$arg_no_cache 命中，读缓存被跳过"}
  ]
}
