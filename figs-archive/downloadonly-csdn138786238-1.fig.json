{"title": "dnf 原生 --downloadonly（RHEL 9，无需插件）", "lines": [
  {"t": "cmd", "s": "dnf install --downloadonly \\"},
  {"t": "cmd", "s": "  --downloaddir=/tmp/dl wget"},
  {"t": "out", "s": "Total download size: 882 k"},
  {"t": "out", "s": "DNF will only download packages for the"},
  {"t": "out", "s": "  transaction."},
  {"t": "out", "s": "Exiting on user Command"},
  {"t": "cmd", "s": "ls /tmp/dl/"},
  {"t": "out", "s": "wget-1.21.3-3.el9.x86_64.rpm"},
  {"t": "note", "s": "实测环境：rockylinux:9（RHEL 9 同源）"}
]}
