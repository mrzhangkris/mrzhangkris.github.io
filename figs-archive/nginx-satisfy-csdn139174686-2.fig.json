{"title": "satisfy all 实测", "lines": [
  {"t": "config", "s": "satisfy all; allow 127.0.0.1; deny all; auth_basic ..."},
  {"t": "cmd", "s": "curl -s -o /dev/null -w \"%{http_code}\" localhost"},
  {"t": "out", "s": "401 (无凭证)"},
  {"t": "cmd", "s": "curl -s -u user1:wrong ... -w \"%{http_code}\""},
  {"t": "out", "s": "401 (密码错误)"},
  {"t": "cmd", "s": "curl -s -u user:password1 localhost"},
  {"t": "out", "s": "200 SECRET AREA"},
  {"t": "note", "s": "且的关系：IP 与密码缺一不可"}
]}
