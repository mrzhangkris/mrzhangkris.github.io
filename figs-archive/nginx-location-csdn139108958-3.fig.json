{"title": "嵌套 location 实测", "lines": [
  {"t": "config", "s": "location /images { return 200 \"OUTER\";"},
  {"t": "config", "s": "  location ~ \\.jpg$ { return 200 \"INNER\"; } }"},
  {"t": "cmd", "s": "curl -s localhost/images/pic.jpg"},
  {"t": "out", "s": "INNER"},
  {"t": "cmd", "s": "curl -s localhost/images/pic.png"},
  {"t": "out", "s": "OUTER"},
  {"t": "note", "s": "嵌套正则只在父块范围内细分：jpg 进内层，png 留外层"},
  {"t": "note", "s": "实测环境：nginx/1.31.5（docker nginx:alpine 容器）"}
]}
