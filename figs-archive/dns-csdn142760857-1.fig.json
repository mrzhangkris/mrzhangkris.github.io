  {"t": "out", "s": "BIND 9.16.23-RH (Extended Support Version) <id:fde3b1f>"},
  {"t": "cmd", "s": "rpm -q bind"},
  {"t": "out", "s": "bind-9.16.23-40.el9_8.8.aarch64"},
  {"t": "note", "s": "实测环境：Rocky Linux 9 容器（dnf 4.14.0，aarch64）"}
