{
  "title": "dpkg 查询已安装包（Debian 12 实测）",
  "lines": [
    {"t": "cmd", "s": "dpkg -l curl"},
    {"t": "out", "s": "ii  curl  7.88.1-10+deb12u15  arm64  command line tool..."},
    {"t": "cmd", "s": "dpkg -s curl | head -2"},
    {"t": "out", "s": "Package: curl"},
    {"t": "out", "s": "Status: install ok installed"},
    {"t": "note", "s": "ii=正常安装，rc=已移除但配置残留（purge 才清掉）"},
    {"t": "note", "s": "实测环境：debian:12 容器（dpkg 1.21.23，curl 7.88.1）"}
  ]
}
