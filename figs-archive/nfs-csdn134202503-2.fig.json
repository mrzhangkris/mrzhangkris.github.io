{"title": "启动服务并验证 RPC 注册表", "lines": [
  {"t": "cmd", "s": "systemctl start rpcbind"},
  {"t": "cmd", "s": "systemctl start nfs-server"},
  {"t": "cmd", "s": "rpcinfo -p localhost"},
  {"t": "out", "s": "100003    3   tcp   2049  nfs"},
  {"t": "out", "s": "100003    4   tcp   2049  nfs"},
  {"t": "out", "s": "100005    1   tcp  20048  mountd"},
  {"t": "cmd", "s": "showmount -e localhost"},
  {"t": "out", "s": "Export list for localhost:"},
  {"t": "out", "s": "/export/nfs 192.168.254.0/24"},
  {"t": "note", "s": "实测环境：Rocky Linux 9 容器（2026-09）"}
]}
