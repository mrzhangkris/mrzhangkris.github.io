{"title": "无 burst：严格限速", "lines": [
  {"t": "config", "s": "limit_req zone=z2;   # rate=3r/s，无 burst"},
  {"t": "cmd", "s": "for i in $(seq 1 10); do curl -s -o /dev/null \\"},
  {"t": "cmd", "s": "  -w \"%{http_code} \" localhost:8095/strict/; done"},
  {"t": "out", "s": "200 503 503 503 503 503 503 503 503 503"},
  {"t": "note", "s": "间隔小于 333ms 的一律拒绝"},
  {"t": "note", "s": "实测：nginx:1.28-alpine 容器（nginx/1.28.3）"}
]}
