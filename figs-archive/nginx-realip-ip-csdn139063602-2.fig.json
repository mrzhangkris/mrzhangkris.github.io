{
  "title": "recursive off：直接取 XFF 最后一跳（容器实拍）",
  "lines": [
    {"t": "config", "s": "set_real_ip_from 127.0.0.1;  real_ip_recursive off;"},
    {"t": "cmd", "s": "curl -s -H 'X-Forwarded-For: 203.0.113.7, 10.0.0.5' localhost"},
    {"t": "out", "s": "remote_addr=10.0.0.5"},
    {"t": "out", "s": "xff=203.0.113.7, 10.0.0.5"},
    {"t": "note", "s": "off：取 XFF 最后一个地址，不回溯"},
    {"t": "note", "s": "日志同帧：10.0.0.5 - \"GET /\" 200 \"203.0.113.7, 10.0.0.5\""}
  ]
}
