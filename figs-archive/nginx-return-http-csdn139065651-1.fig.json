{"title": "503 维护页与 always 开关", "lines": [
  {"t": "cmd", "s": "curl -si localhost/maint | grep -iE 'retry-after|HTTP/'"},
  {"t": "out", "s": "HTTP/1.1 503 Service Temporarily Unavailable"},
  {"t": "note", "s": "没加 always：Retry-After 头整个消失"},
  {"t": "config", "s": "add_header Retry-After \"3600\" always;"},
  {"t": "cmd", "s": "curl -si localhost/maint | grep -iE 'retry-after|HTTP/'"},
  {"t": "out", "s": "HTTP/1.1 503 Service Temporarily Unavailable"},
  {"t": "out", "s": "Retry-After: 3600"},
  {"t": "note", "s": "4xx/5xx 想带自定义头，必须 always"},
  {"t": "note", "s": "内置错误页 Content-Length 实测 197 字节；nginx/1.31.5"}
]}
