{"title": "单 IP 白名单实测（nginx/1.31.5 容器）", "lines": [
  {"t": "config", "s": "allow 127.0.0.1;   # 名单里有本机"},
  {"t": "config", "s": "deny all;"},
  {"t": "cmd", "s": "curl -s -o /dev/null -w %{http_code} 127.0.0.1/"},
  {"t": "out", "s": "200"},
  {"t": "config", "s": "allow 192.168.1.1;  # 名单里没有本机"},
  {"t": "config", "s": "deny all;"},
  {"t": "cmd", "s": "curl -s -o /dev/null -w %{http_code} 127.0.0.1/"},
  {"t": "out", "s": "403"},
  {"t": "note", "s": "日志 access forbidden by rule，死在 IP 规则上"}
]}
