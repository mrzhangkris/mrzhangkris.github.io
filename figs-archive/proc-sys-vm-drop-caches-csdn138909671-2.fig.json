{
  "title": "echo 3 全清：Slab 271584→135456 kB",
  "lines": [
    {"t": "cmd", "s": "find / -xdev -type f > /dev/null  # 填充 dentry/inode"},
    {"t": "cmd", "s": "cat /tmp/big > /dev/null"},
    {"t": "out", "s": "buff/cache=579MB  Slab=271584 kB"},
    {"t": "cmd", "s": "sync && echo 3 > /proc/sys/vm/drop_caches"},
    {"t": "out", "s": "buff/cache=246MB  Slab=135456 kB"},
    {"t": "note", "s": "# grep Slab /proc/meminfo 前后对比;dentry/inode 减半"},
    {"t": "note", "s": "实测环境：Rocky Linux 9.3 特权容器"}
  ]
}
