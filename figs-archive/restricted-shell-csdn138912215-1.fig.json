{"title": "RHEL9 默认无 /bin/rbash，需手动建软链", "lines": [
  {"t": "cmd", "s": "rpm -q bash; ls /usr/bin/rbash"},
  {"t": "out", "s": "bash-5.1.8-6.el9_1.aarch64"},
  {"t": "out", "s": "ls: cannot access '/usr/bin/rbash': No such file"},
  {"t": "cmd", "s": "ln -s /usr/bin/bash /usr/bin/rbash"},
  {"t": "cmd", "s": "useradd -m -s /bin/rbash restricted_user"},
  {"t": "note", "s": "bash 以 argv0=rbash 启动即进入受限模式"},
  {"t": "note", "s": "实测环境：rockylinux:9"}
]}
