{"title": "dhcpd 启动后确认监听网口与网段", "lines": [
  {"t": "cmd", "s": "ip link set eth0 address 00:11:22:33:44:55"},
  {"t": "cmd", "s": "ip addr add 192.168.254.2/24 dev eth0"},
  {"t": "cmd", "s": "dhcpd -d -cf /etc/dhcp/dhcpd.conf eth0 &"},
  {"t": "out", "s": "Listening on LPF/eth0/00:11:22:33:44:55/"},
  {"t": "out", "s": "  192.168.254.0/24"},
  {"t": "note", "s": "服务端已绑定本网段，开始等待客户端 DISCOVER"}
]}
