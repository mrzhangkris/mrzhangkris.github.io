{
  "title": "parted 3.5 loop 盘全流程实测",
  "type": "cmd",
  "lines": [
    {"t": "cmd", "s": "losetup -f --show -P /tmp/disk2.img"},
    {"t": "out", "s": "/dev/loop8"},
    {"t": "cmd", "s": "parted -s /dev/loop8 mklabel gpt"},
    {"t": "cmd", "s": "parted -s /dev/loop8 mkpart primary ext4 1MiB 500MiB"},
    {"t": "cmd", "s": "parted /dev/loop8 align-check optimal 1"},
    {"t": "out", "s": "1 aligned"},
    {"t": "out", "s": " 1      1049kB  524MB  523MB               primary"},
    {"t": "note", "s": "# 盘为稀疏文件模拟;print→mklabel→mkpart→align-check→resizepart"},
    {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器 (GNU parted 3.5)"}
  ]
}
