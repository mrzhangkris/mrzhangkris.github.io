{"title": "USR2 后双 master 并存，pid 文件换名", "lines": [
  {"t": "cmd", "s": "kill -USR2 2729"},
  {"t": "cmd", "s": "ps | grep \"nginx: master\" | grep srv"},
  {"t": "out", "s": "2729 nginx: master process /usr/sbin/nginx -p /srv/nginx1 ..."},
  {"t": "out", "s": "2752 nginx: master process /usr/sbin/nginx -p /srv/nginx1 ..."},
  {"t": "cmd", "s": "ls /srv/nginx1/logs | grep pid"},
  {"t": "out", "s": "nginx.pid"},
  {"t": "out", "s": "nginx.pid.oldbin"},
  {"t": "note", "s": "新 master(2752) 接管 nginx.pid，旧 pid 改名 .oldbin"},
  {"t": "note", "s": "实测：nginx:1.28-alpine 容器，1.28.3 -> 1.30.4 实升"}
]}
