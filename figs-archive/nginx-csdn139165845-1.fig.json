{"title": "反向代理透传实测（server_tokens off + gzip）", "lines": [
  {"t": "note", "s": "后端用 return 200 回显收到的请求头（$http_* 变量）"},
  {"t": "config", "s": "proxy_set_header Host $host;"},
  {"t": "config", "s": "proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"},
  {"t": "cmd", "s": "curl -si --compressed localhost/"},
  {"t": "out", "s": "Server: nginx"},
  {"t": "out", "s": "Content-Encoding: gzip"},
  {"t": "out", "s": "host=localhost|realip=127.0.0.1|xff=127.0.0.1|proto=http"},
  {"t": "note", "s": "版本号被隐藏；host/realip/xff/proto 全部穿透到后端"},
  {"t": "note", "s": "实测环境：nginx/1.31.5（docker nginx:alpine 容器）"}
]}
