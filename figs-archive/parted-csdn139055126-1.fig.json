{
  "title": "print 先看盘：空白 loop 盘",
  "type": "cmd",
  "lines": [
    {"t": "cmd", "s": "truncate -s 1G /tmp/disk2.img"},
    {"t": "cmd", "s": "losetup -f --show -P /tmp/disk2.img"},
    {"t": "out", "s": "/dev/loop8"},
    {"t": "cmd", "s": "parted /dev/loop8 print"},
    {"t": "out", "s": "Error: /dev/loop8: unrecognised disk label"},
    {"t": "out", "s": "Disk /dev/loop8: 1074MB"},
    {"t": "out", "s": "Partition Table: unknown"},
    {"t": "note", "s": "# 空盘连分区表都没有;物理盘此处显示 gpt/msdos 与分区列表"},
    {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器 (GNU parted 3.5)"}
  ]
}
