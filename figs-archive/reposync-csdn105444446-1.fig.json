{"title": "reposync 同步本地仓库（实测）", "lines": [
  {"t": "cmd", "s": "dnf reposync --repoid=localrepo \\"},
  {"t": "cmd", "s": "  --download-path=/data/mirror --newest-only"},
  {"t": "out", "s": "(1/3): file-5.39-17.el9.aarch64.rpm   48 kB"},
  {"t": "out", "s": "(2/3): tree-1.8.0-10.el9.aarch64.rpm  54 kB"},
  {"t": "out", "s": "(3/3): which-2.21-30.el9_6.aarch64.rpm 40 kB"},
  {"t": "cmd", "s": "find /data/mirror -name '*.rpm'"},
  {"t": "out", "s": "/data/mirror/localrepo/which-...rpm"},
  {"t": "out", "s": "/data/mirror/localrepo/tree-...rpm"},
  {"t": "out", "s": "/data/mirror/localrepo/file-...rpm"},
  {"t": "note", "s": "实测环境：rockylinux:9，按 repoid 自动建同名子目录"}
]}
