{
  "title": "Rocky 9 实测：自建仓库同步成功",
  "type": "cmd",
  "lines": [
    {"t": "cmd", "s": "dnf download -q tree which unzip"},
    {"t": "cmd", "s": "createrepo_c -q /root/myrpms"},
    {"t": "config", "s": "[myrepo] baseurl=file:///root/myrpms"},
    {"t": "cmd", "s": "dnf reposync --repoid=myrepo --download-path=/tmp/mirror2 \\"},
    {"t": "cmd", "s": "  --newest-only --download-metadata"},
    {"t": "out", "s": "(3/3): which-2.21-30.el9_6.aarch64.rpm   |  40 kB  00:00"},
    {"t": "note", "s": "# /tmp/mirror2/myrepo/ 下 3 个 rpm + repodata/(primary/filelists)"},
    {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器 (dnf 4.14)"}
  ]
}
