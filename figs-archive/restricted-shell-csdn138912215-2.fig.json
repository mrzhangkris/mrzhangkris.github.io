{"title": "建受限用户：白名单目录 + 收窄 PATH", "lines": [
  {"t": "config", "s": "useradd -m -s /bin/rbash restricted_user"},
  {"t": "config", "s": "mkdir /home/restricted_user/bin"},
  {"t": "config", "s": "ln -s /usr/bin/ls /home/restricted_user/bin/ls"},
  {"t": "config", "s": ".bash_profile: PATH=$HOME/bin / export PATH"},
  {"t": "cmd", "s": "su - restricted_user -c 'echo $PATH'"},
  {"t": "out", "s": "/home/restricted_user/bin"},
  {"t": "cmd", "s": "su - restricted_user -c 'echo hello-rbash'"},
  {"t": "out", "s": "hello-rbash"},
  {"t": "note", "s": "启动文件里设 PATH 合法；登录后 PATH 只剩 ~/bin"},
  {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器"}
]}
