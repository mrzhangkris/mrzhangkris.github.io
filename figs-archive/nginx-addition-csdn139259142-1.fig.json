{
  "title": "add_after_body 追加页脚（nginx/1.28.3 容器实拍）",
  "lines": [
    {"t": "config", "s": "location ~ \\.html$ { add_after_body /footer.html; }"},
    {"t": "cmd", "s": "curl -s localhost/main.html"},
    {"t": "out", "s": "<h1>MAIN</h1>"},
    {"t": "out", "s": "<div>FOOTER</div>"},
    {"t": "note", "s": "页脚由 Nginx 内部子请求拼入，客户端只发一次请求"}
  ]
}
