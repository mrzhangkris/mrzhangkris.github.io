{"title": "root 拼接实测", "lines": [
  {"t": "config", "s": "root /usr/share/nginx/html;"},
  {"t": "config", "s": "location / { try_files $uri $uri/ =404; }"},
  {"t": "cmd", "s": "curl -s localhost/images/logo.png"},
  {"t": "out", "s": "LOGO"},
  {"t": "note", "s": "实际路径 = root + URI：/usr/share/nginx/html/images/logo.png"}
]}
