{
  "title": "Apache 2.4.41 to 2.4.46 smooth upgrade",
  "type": "cmd",
  "lines": [
    {"t": "cmd", "s": "apachectl -v"},
    {"t": "out", "s": "Server version: Apache/2.4.41 (Unix)"},
    {"t": "cmd", "s": "tar -xzf httpd-2.4.46.tar.gz && cd httpd-2.4.46"},
    {"t": "cmd", "s": "./configure --prefix=/usr/local/apache2.4.46"},
    {"t": "cmd", "s": "make"},
    {"t": "cmd", "s": "sudo make install"},
    {"t": "note", "s": "新版本装进独立目录，旧版本照常运行"},
    {"t": "cmd", "s": "/usr/local/apache2.4.41/bin/apachectl -k stop"},
    {"t": "cmd", "s": "/usr/local/apache2.4.46/bin/apachectl -k start"},
    {"t": "note", "s": "测试稳定后再切换，回滚只需反向启停"}
  ]
}
