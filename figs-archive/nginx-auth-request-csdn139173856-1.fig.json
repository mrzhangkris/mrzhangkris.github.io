{"title": "三种状态码对号入座", "lines": [
  {"t": "cmd", "s": "curl -s -w \"|%{http_code}\" -H \"Authorization: Basic dXNlcm5hbWU6cGFzc3dvcmQ=\" localhost/protected/data.txt"},
  {"t": "out", "s": "SECRET DATA|200"},
  {"t": "cmd", "s": "curl -s -w \"|%{http_code}\" localhost/protected/data.txt"},
  {"t": "out", "s": "Unauthorized|401"},
  {"t": "cmd", "s": "curl -s -w \"|%{http_code}\" -H \"Authorization: Basic dXNlcm5hbWU6cGFzc3dvcmQ=\" localhost/protected/admin/panel.txt"},
  {"t": "out", "s": "Forbidden|403"},
  {"t": "note", "s": "/admin 路径凭证正确也被 403：X-Original-URI 生效"},
  {"t": "note", "s": "实测环境：nginx:1.28-alpine 容器（nginx/1.28.3）"}
]}
