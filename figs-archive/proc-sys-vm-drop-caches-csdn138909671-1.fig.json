{
  "title": "echo 1 释放页面缓存：buff/cache 2962→372MB",
  "lines": [
    {"t": "cmd", "s": "dd if=/dev/zero of=/tmp/big bs=1M count=200"},
    {"t": "cmd", "s": "cat /tmp/big > /dev/null    # 读入页面缓存"},
    {"t": "cmd", "s": "free -m | grep Mem"},
    {"t": "out", "s": "buff/cache=2962MB  available=7117MB"},
    {"t": "cmd", "s": "sync && echo 1 > /proc/sys/vm/drop_caches"},
    {"t": "cmd", "s": "free -m | grep Mem"},
    {"t": "out", "s": "buff/cache=372MB  available=7142MB"},
    {"t": "note", "s": "# 释放的是所在内核全部页面缓存(含刚读入的 200MB 文件)"},
    {"t": "note", "s": "实测环境：Rocky Linux 9.3 特权容器 (容器内 root 直写)"}
  ]
}
