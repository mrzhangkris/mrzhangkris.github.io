{"title": "weight=2：10 次请求的分布", "lines": [
  {"t": "cmd", "s": "for i in $(seq 10); do curl -so /dev/null localhost; done"},
  {"t": "cmd", "s": "tail -10 /var/log/nginx/lb.log | awk '{print $2}' | sort | uniq -c"},
  {"t": "out", "s": "   3 127.0.0.1:8081"},
  {"t": "out", "s": "   5 127.0.0.1:8082"},
  {"t": "out", "s": "   2 127.0.0.1:8083"},
  {"t": "note", "s": "8082 拿 5 次，总比例符合 2:1:1"},
  {"t": "note", "s": "排列由平滑加权决定，别按固定序列写断言"},
  {"t": "note", "s": "实测环境：nginx:alpine 容器 (nginx/1.31.5)，worker=1"}
]}
