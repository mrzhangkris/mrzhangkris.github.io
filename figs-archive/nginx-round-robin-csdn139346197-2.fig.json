{"title": "weight=2 加权序列实测", "lines": [
  {"t": "config", "s": "server 127.0.0.1:8082 weight=2;"},
  {"t": "cmd", "s": "for i in $(seq 10); do curl -s localhost; done"},
  {"t": "out", "s": "8082 8081 8083 8082 8082 8081 8083 8082 8082 8081"},
  {"t": "out", "s": "统计: 8082×5 8081×3 8083×2"},
  {"t": "note", "s": "比例 2:1:1 成立，排列由平滑加权算法错开"}
]}
