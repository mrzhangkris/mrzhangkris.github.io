{"title": "map 按 cookie 灰度分流实测", "lines": [
  {"t": "config", "s": "map $cookie_version $backend {"},
  {"t": "config", "s": "  v2 \"v2-backend\";  default \"v1-backend\";"},
  {"t": "config", "s": "}   # 实测用回显标记代替真实 proxy_pass"},
  {"t": "cmd", "s": "curl -s -H \"Cookie: version=v2\" localhost/"},
  {"t": "out", "s": "backend=v2-backend"},
  {"t": "cmd", "s": "curl -s localhost/"},
  {"t": "out", "s": "backend=v1-backend"},
  {"t": "note", "s": "灰度名单从改配置 reload 变成发 cookie，运营可控"},
  {"t": "note", "s": "实测环境：nginx/1.31.5（docker nginx:alpine 容器）"}
]}
