{"title": "逐项实测：rbash 拦截清单", "lines": [
  {"t": "cmd", "s": "cd /tmp"},
  {"t": "out", "s": "-rbash: cd: restricted"},
  {"t": "cmd", "s": "/bin/ls /"},
  {"t": "out", "s": "-rbash: /bin/ls: restricted: cannot specify `/' in command names"},
  {"t": "cmd", "s": "echo test > /tmp/out.txt"},
  {"t": "out", "s": "-rbash: /tmp/out.txt: restricted: cannot redirect output"},
  {"t": "cmd", "s": "PATH=/usr/bin:$PATH"},
  {"t": "out", "s": "-rbash: PATH: readonly variable"},
  {"t": "note", "s": "rm、python3 等白名单外命令一律 command not found"},
  {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器（受限用户交互登录）"}
]}
