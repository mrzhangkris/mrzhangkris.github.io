{"title": "服务端写导出规则并生效", "lines": [
  {"t": "cmd", "s": "mkdir -p /export/nfs && chmod 666 /export/nfs"},
  {"t": "config", "s": "/export/nfs 192.168.254.0/24(rw,no_root_squash,"},
  {"t": "config", "s": "             no_all_squash,sync)"},
  {"t": "cmd", "s": "exportfs -r"},
  {"t": "note", "s": "无报错输出即生效"},
  {"t": "cmd", "s": "exportfs -v"},
  {"t": "out", "s": "/export/nfs  192.168.254.0/24(sync,wdelay,hide,"},
  {"t": "out", "s": "  no_subtree_check,sec=sys,rw,no_root_squash,no_all_squash)"},
  {"t": "note", "s": "实测环境：Rocky Linux 9 容器，nfs-utils 2.5.4（2026-09）"}
]}
