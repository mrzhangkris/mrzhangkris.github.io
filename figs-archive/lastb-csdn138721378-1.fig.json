{"title": "lastb 实测（Rocky 9, util-linux）", "lines": [
  {"t": "note", "s": "记录由 utmpdump -r 构造写入 /var/log/btmp"},
  {"t": "cmd", "s": "lastb"},
  {"t": "out", "s": "ssh:nott root    192.168.0.201  Mon Feb 13 11:38 - 11:38  (00:00)"},
  {"t": "out", "s": "ssh:nott erdaf   192.168.0.201  Mon Feb 13 11:06 - 11:06  (00:00)"},
  {"t": "note", "s": "列：用户名 · 终端 · 来源 IP · 起止时间"},
  {"t": "cmd", "s": "lastb -n 1"},
  {"t": "out", "s": "（只显示最近 1 条，-1 简写等效）"},
  {"t": "cmd", "s": "lastb -d"},
  {"t": "out", "s": "IP 列反解为主机名，无 PTR 记录时仍显示 IP"}
]}
