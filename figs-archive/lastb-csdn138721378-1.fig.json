{"title": "真实失败登录的产生与查看", "lines": [
  {"t": "cmd", "s": "ssh-keygen -A >/dev/null && /usr/sbin/sshd"},
  {"t": "cmd", "s": "useradd -m testu && echo 'testu:RealPass123' | chpasswd"},
  {"t": "cmd", "s": "sshpass -p Wrong1 ssh -o StrictHostKeyChecking=no root@localhost true"},
  {"t": "out", "s": "Permission denied, please try again."},
  {"t": "cmd", "s": "sshpass -p abc123 ssh -o StrictHostKeyChecking=no admin@localhost true"},
  {"t": "out", "s": "Permission denied, please try again."},
  {"t": "cmd", "s": "lastb"},
  {"t": "out", "s": "admin  ssh:notty  ::1  Mon Sep 14 00:30 - 00:30  (00:00)"},
  {"t": "out", "s": "root   ssh:notty  ::1  Mon Sep 14 00:30 - 00:30  (00:00)"},
  {"t": "note", "s": "实测环境：Rocky Linux 9.3 容器（openssh 9.9p1，本机自连）"}
]}
