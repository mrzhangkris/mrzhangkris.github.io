{
  "extends": "markdownlint-cli2/recommended",
  "config": {
    "default": true,
    "MD001": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD009": true,
    "MD010": true,
    "MD012": true,
    "MD013": false,
    "MD014": true,
    "MD018": true,
    "MD019": true,
    "MD022": true,
    "MD023": true,
    "MD024": true,
    "MD025": true,
    "MD026": true,
    "MD027": true,
    "MD028": true,
    "MD029": { "style": "one_or_ordered" },
    "MD030": true,
    "MD031": true,
    "MD032": true,
    "MD033": false,
    "MD034": true,
    "MD035": { "style": "---" },
    "MD036": false,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD040": true,
    "MD041": false,
    "MD042": true,
    "MD043": false,
    "MD044": false,
    "MD045": true,
    "MD046": { "style": "fenced" },
    "MD047": true,
    "MD048": { "style": "backtick" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" }
  },
  "ignores": [
    "node_modules/**",
    "public/**",
    "db.json",
    "yarn.lock",
    "package-lock.json"
  ]
}
